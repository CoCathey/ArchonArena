# Copy to .env.production on the server and fill in real values.
# NEVER commit .env.production.

DOMAIN=archonarena.com

# PostgreSQL
DB_USER=archonarena
DB_PASSWORD=<generate: openssl rand -hex 24>
DB_NAME=archonarena

# JWT signing secret for user sessions (rotating this logs everyone out)
SECRET=<generate: openssl rand -hex 32>

# HMAC secret used for e.g. email activation links
HMAC_SECRET=<generate: openssl rand -hex 32>

# Email: account activation, password reset, and notifications (round pairings,
# match scheduling, round deadlines).
#
# REQUIRED for a public site. Nothing here configured means no mail at all, and
# because a failed activation email rolls the new account back, it means NO ONE
# CAN REGISTER - not merely that password reset is unavailable.
#
# The sender must be an address at a domain your provider has verified.
EMAIL_FROM_ADDRESS=noreply@archonarena.com
EMAIL_REPLY_TO=
#
# --- Option A: Resend (recommended) -----------------------------------------
# One setting. Sign up at resend.com, add your domain, paste in the three DNS
# records it gives you, create an API key, and put it here. Sends over HTTPS
# rather than SMTP, which matters: many hosts block outbound ports 587 and 465,
# and what that produces is a connection that hangs rather than an error saying
# what is wrong. Setting this alone selects Resend.
RESEND_API_KEY=
#
# --- Option B: SMTP ---------------------------------------------------------
# Any provider that speaks SMTP: Resend, Brevo, Postmark, Mailgun, a company
# relay. Setting SMTP_HOST selects this when RESEND_API_KEY is blank. Leave
# SMTP_SECURE blank: implicit TLS is inferred on port 465, STARTTLS otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
#
# --- Option C: AWS SES ------------------------------------------------------
# Cheapest at volume, but needs an AWS account, and its sandbox has to be
# lifted by a support request before you can email anyone who has not verified
# their own address. Used when both options above are blank.
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Force the choice if the automatic one is wrong:
#   auto (default) | resend | smtp | ses
EMAIL_TRANSPORT=
#
# --- Staying inside the plan ------------------------------------------------
# Every entry plan is a hard cap with a cliff at the end of it, and past it the
# provider refuses ALL mail - including the activation link a new player needs.
# A sixteen-player Swiss is 64 pairing emails, so this is reachable in an
# afternoon.
#
# These default to Resend's free plan (100/day, 3,000/month). Notification mail
# stops at EMAIL_BULK_RESERVE of each cap - 0.2 keeps the last 20 sends of the
# day for activation and password reset - while the in-app notification still
# lands either way. Set the limits to 0 if you are on a paid plan or your own
# relay. Raise them to match if you upgrade.
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_BULK_RESERVE=0.2

# Require players to confirm their email before they can log in. ON by default.
# Registration then DEPENDS on the SES settings above: if a send fails the account
# is rolled back, so a site with broken email accepts no new accounts at all.
# Prove it works before opening sign-ups:
#     docker compose -f docker-compose.prod.yml --env-file .env.production \
#       exec lobby npm run check:email -- you@example.com
# Set to false to run without email, accepting that people can play under
# addresses they do not own. Leave blank to keep the default (on).
REQUIRE_ACTIVATION=

# Public origin, used to build absolute links in notification email (round
# pairings, friend requests). Activation and reset mail derive this from the
# request they were triggered by; a notification raised by a background job has
# no request to derive it from. Leave empty and those links stay relative —
# still readable, but not clickable from an inbox.
SITE_URL=https://archonarena.com

# Optional: release identifier shown in the client / used by Sentry
VERSION=

# Optional: error tracking
SENTRY_DSN=

# Content-Security-Policy: enforce (default) | report-only | off.
# Set report-only if the site needs an origin the policy does not yet allow —
# violations then show in the browser console instead of breaking the page.
# Directives are documented in server/csp.js.
CSP_MODE=enforce

# Optional: hCaptcha secret key for registration
CAPTCHA_KEY=

# Optional: Decks of KeyForge API key for SAS scores. Generate it at
# https://decksofkeyforge.com/about/sellers-and-devs while logged in.
#
# DoK issues ONE key per account, generating voids the previous one instantly,
# and there is no way to read an existing key back - the page shows a key only
# in the moment it is created. So treat generating as a rotation: copy the key
# immediately and put that same string everywhere you use DoK.
#
# In particular this key and any key pasted into the site's own "sync my
# collection" box must be the SAME string. Generating a fresh key for a
# collection sync silently kills SAS for every player on the server, and the
# symptom (no SAS) looks nothing like the cause. If SAS stops working, check
# this first.
#
# Consider a DoK account dedicated to the server, so an operator rotating their
# personal key cannot take site-wide SAS down with them.
DOK_API_KEY=

# Optional: Patreon supporter linking.
#
# Setup (see docs/design/patreon.md for the full walkthrough):
#   1. Create your campaign at https://www.patreon.com/create
#   2. Register an OAuth client at
#      https://www.patreon.com/portal/registration/register-clients
#   3. Add https://archonarena.com/patreon as a Redirect URI on that client -
#      it must match PATREON_CALLBACK_URL character for character, or Patreon
#      refuses the code exchange with invalid_grant.
#   4. Copy the Client ID and Client Secret from the same page.
#   5. Find your campaign id (the client page shows a creator access token):
#        curl -H "Authorization: Bearer <creator-access-token>" \
#          https://www.patreon.com/api/oauth2/v2/campaigns
#      Set it below. WITHOUT IT, a pledge to any creator on Patreon counts as a
#      pledge to you, and those players get the supporter role here.
#
# Leaving PATREON_CLIENT_ID blank keeps the whole integration off: no Patreon
# UI is rendered and no supporter roles are granted or revoked.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# Defaults to https://archonarena.com/patreon; set only on another domain.
PATREON_CALLBACK_URL=
# Your public campaign page, linked from the profile for players who have not
# pledged yet. Optional.
PATREON_CAMPAIGN_URL=
# Kill switch. Leave blank for on; set false to disable without removing the
# credentials (existing links are kept and supporter roles are left untouched).
PATREON_ENABLED=

# Optional: Keybringer SSO. Requires a confidential client registered in the
# Keycloak realm with redirect URI https://archonarena.com/api/account/oidc/callback
OIDC_ENABLED=false
OIDC_ISSUER=https://account.keybringer.com/realms/keybringer
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://archonarena.com/api/account/oidc/callback

# --- Backups -----------------------------------------------------------------
# deploy/backup.sh, run nightly from root's crontab:
#     0 5 * * * cd /opt/archonarena && bash deploy/backup.sh >> /var/log/archon-backup.log 2>&1
#
# The archive holds the database and the uploaded avatars and backgrounds. It is
# encrypted with BACKUP_PASSPHRASE, so KEEP THAT PASSPHRASE SOMEWHERE ELSE TOO —
# a password manager, not only this file. It is the one input that cannot be
# reconstructed, and it lives on the machine the backup exists to survive.
#     openssl rand -base64 48
BACKUP_PASSPHRASE=

# Where archives are staged before upload, and how many to keep on each side.
BACKUP_DIR=/var/backups/archonarena
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_REMOTE=30

# Off-host destination. Set ONE of these; without either, backup.sh still runs
# but warns, and deploy/healthcheck.sh FAILs — a copy on the same disk as the
# database protects against a bad migration and against nothing else.
#
# Any S3-compatible storage works. Leave BACKUP_S3_ENDPOINT empty for AWS; set
# it for Cloudflare R2 (https://<account>.r2.cloudflarestorage.com), Backblaze
# B2 (https://s3.<region>.backblazeb2.com), Wasabi, MinIO and so on.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=archonarena
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# ...or a second machine you control, over ssh. Needs a key with no passphrase
# for the cron user, and the remote path to exist.
#     BACKUP_RSYNC_TARGET=backups@other-host:/srv/archonarena
BACKUP_RSYNC_TARGET=

# Card art is ~6k images that `npm run fetchdata` re-downloads, so it is left
# out by default to keep nightly uploads small. Avatars and custom backgrounds
# are player uploads that exist nowhere else and are always included.
BACKUP_INCLUDE_CARD_ART=false

# Only for a stack where Postgres or the images are not in docker-compose (a
# managed database, say). Left blank, backup.sh and restore.sh reach into the
# compose services, which is what a standard deployment wants.
#     BACKUP_PG_URI=postgres://user:password@db.internal:5432
#     BACKUP_IMAGE_ROOT=/srv/archonarena/img
BACKUP_PG_URI=
BACKUP_IMAGE_ROOT=
