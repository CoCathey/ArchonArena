bower_components
node_modules
public/*
!public/banner
# ARCHON: track the small root-level site assets (favicons, manifest) so a
# fresh clone / Docker build has them. Large image dirs (public/img/*) stay ignored.
!public/*.png
!public/*.ico
!public/*.svg
!public/site.webmanifest
dist*
typings
coverage
*.log
*.json
!client/locales/*.json
!master-vault-data/**/*.json
!server/game/chatCommands.json
# ARCHON: package manifests are needed for the Docker build (npm ci); the broad
# *.json rule above would otherwise exclude them.
!package.json
!package-lock.json
# ARCHON: the Expo app's config must reach the EAS build machine. Both files are
# tracked, but EAS builds its upload archive by applying these ignore patterns
# (not git's index), so the *.json rule above silently dropped them: prebuild
# then fell back to package.json's name and generated an Xcode target called
# "archonarenamobile" instead of "ArchonArena", failing every iOS build at the
# "Configure Xcode project" step.
!mobile/app.json
!mobile/eas.json
# ARCHON: how far we have pulled in from keyteki. It has to be tracked - it is
# the sync's memory, and an ignored one would silently never advance, so every
# run would re-propose the same upstream changes forever.
!upstream-sync.json
server/events.txt
.DS_Store
config/local*
server/logs/*.gz
build/
!tsconfig.json
data
mongodb
keyteki-json-data

/.idea/
server/game/partialcards
server/game/generatedcards

# Sentry Config File
.env.sentry-build-plugin

bin/
obj/
.env.development
tmp/

# Production secrets - never commit
.env.production
# ...including the timestamped copies deploy/patreon-setup.sh leaves behind.
# A backup holds everything the original did - DB password, SECRET, HMAC_SECRET,
# the Patreon client secret - so an unignored one is the same leak with a
# different filename, and it would slip past `git add -A` unnoticed.
.env.production.bak.*
.env.*.bak.*
config/local*.json5
dump.rdb
