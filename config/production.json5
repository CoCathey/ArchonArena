{
    // Production overrides, loaded when NODE_ENV=production.
    // Secrets and connection strings come from environment variables
    // (see custom-environment-variables.json5 and .env.production.example);
    // only non-secret production defaults belong in this file.

    redisKeyPrefix: 'archonarena:prod',

    gameNode: {
        // CRITICAL: leave host empty in production. If set (default.json5
        // uses 'localhost' for dev), the game node advertises it as its
        // public address in the HELLO registration, the lobby hands it to
        // browsers, and every game-board connection dials that host instead
        // of the site origin - Start appears dead and players are stranded
        // in started games they can never see. Empty -> no address in the
        // handoff -> browsers connect same-origin via the Caddy
        // /node-<n>/socket.io proxy.
        host: ''
    },

    patreon: {
        // Must also be registered as a redirect URI on the Patreon client.
        // Override with PATREON_CALLBACK_URL on a site at another domain.
        callbackUrl: 'https://archonarena.com/patreon'
    },

    lobby: {
        appName: 'Archon Arena',
        emailFromAddress: 'noreply@archonarena.com',
        // Absolute links in notification email (SITE_URL). Background-raised
        // notifications have no request to derive the origin from.
        siteUrl: 'https://archonarena.com',
        blockDisposableEmail: true
    }
}
