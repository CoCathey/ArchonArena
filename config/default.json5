{
    env: 'development',

    secret: 'somethingverysecret',
    redisUrl: 'redis://redis/',
    redisKeyPrefix: 'keyteki:dev',
    dbUser: 'keyteki',
    dbHost: 'postgres',
    dbDatabase: 'keyteki',
    dbPassword: 'changemeplease',
    dbPort: 5432,
    minLobbyChatTime: 0, // The time (in seconds) an account has to be registered before it can chat in the lobby
    /*
     * Other global configurations used, but not specified, include:
     *  - sentryDsn (for production only)
     */

    // ARCHON (I5): websocket origins for game nodes that run on their own
    // hosts. The documented topology keeps every node behind the same Caddy, so
    // gameplay websockets are same-origin and the CSP's 'self' covers them;
    // leave this empty unless you have genuinely split nodes onto other hosts.
    // Comma-separated string or array, e.g. 'wss://node1.example.com'.
    gameNodeOrigins: '',

    lobby: {
        port: 4000,
        appName: 'Archon Arena',
        emailFromAddress: 'noreply@archonarena.com',
        // ARCHON: which transport sends the mail. 'auto' (the default) picks
        // SMTP when smtpHost is set and AWS SES otherwise, so an existing SES
        // deployment is unaffected and a new one only fills in what it has.
        // Force it with 'smtp' or 'ses' if the automatic choice is wrong.
        emailTransport: 'auto',
        // SMTP, for any provider that speaks it - Resend, Brevo, Postmark,
        // Mailgun, a company relay. Blank host means SES is used instead.
        // smtpSecure is inferred from the port when unset: implicit TLS on 465,
        // STARTTLS on anything else.
        smtpHost: '',
        smtpPort: 587,
        smtpUser: '',
        smtpPassword: '',
        // ARCHON: public origin, used to build absolute links in notification
        // emails. Activation and reset mail derive this from the request, but a
        // notification raised by a background job (a paired round, a nightly
        // sweep) has no request to derive it from. Empty leaves the link
        // relative, which still reads correctly in the in-app centre.
        siteUrl: '',
        blockDisposableEmail: false,
        // ARCHON: on. New accounts start unverified, cannot log in, and get a
        // confirmation link by email. This was off, which did two things at
        // once: it skipped the email *and* marked every new account verified,
        // so anyone could sign up with an address they did not own and start
        // playing immediately.
        //
        // Turning it on makes registration depend on outbound mail. If
        // lobby.emailFromAddress is unset - or SES is unreachable - the
        // registration is rolled back rather than left unusable, and the boot
        // check in server.js warns about it. Set REQUIRE_ACTIVATION=false for
        // a local instance that has no mail configured.
        requireActivation: true,
        // Content-Security-Policy mode: 'enforce' | 'report-only' | 'off'.
        // Directives live in server/csp.js. Turn this down to 'report-only' if a
        // deployment needs an origin the policy does not yet allow - violations
        // then appear in the browser console instead of breaking the page.
        cspMode: 'enforce',
        hmacSecret: 'somethingevenmoresecret',
        lowerDeckThreshold: 1,
        middleDeckThreshold: 2,
        upperDeckThreshold: 3

        /*
         * Other server configurations used, but not specified, include:
         *  - cookieLifetime
         *  - emailKey
         *  - hmacSecret
         *  - captchaKey (hCaptcha secret key)
         *  - awsSesRegion, awsAccessKeyId, awsSecretAccessKey (AWS SES credentials)
         *  - emailReplyTo (reply-to address; emailFromAddress above is the sender)
         */
    },

    // OpenID Connect SSO login. Disabled until a client is registered in the
    // provider realm (Keybringer/Keycloak): the client id/secret and the
    // redirect URI https://<domain>/api/account/oidc/callback must be
    // configured there first.
    auth: {
        oidc: {
            enabled: false,
            providerName: 'keybringer', // stable key used in the identities table
            providerDisplayName: 'Keybringer',
            issuer: 'https://account.keybringer.com/realms/keybringer',
            clientId: '', // set via OIDC_CLIENT_ID
            clientSecret: '', // set via OIDC_CLIENT_SECRET
            redirectUri: 'http://localhost:4000/api/account/oidc/callback',
            scopes: 'openid profile email',
            requestTimeoutMs: 10000
        }
    },

    // ARCHON (N12): Patreon supporter linking.
    //
    // Dormant until credentials exist - `enabled` on its own does nothing, so a
    // fresh checkout shows no Patreon UI rather than a button that dead-ends on
    // Patreon's error page. To turn it on:
    //
    //  1. Register a client at
    //     https://www.patreon.com/portal/registration/register-clients
    //  2. Add the redirect URI *exactly* as `callbackUrl` below - Patreon
    //     rejects the code exchange on any mismatch, trailing slash included.
    //  3. Set PATREON_CLIENT_ID and PATREON_CLIENT_SECRET.
    //  4. Set PATREON_CAMPAIGN_ID (see docs/design/patreon.md for the one-line
    //     lookup). Without it, a pledge to *any* creator on Patreon counts as a
    //     pledge here.
    patreon: {
        enabled: true, // kill switch; credentials are what actually gate it
        clientId: '', // set via PATREON_CLIENT_ID
        clientSecret: '', // set via PATREON_CLIENT_SECRET
        // Where Patreon sends the player back. Must match the redirect URI
        // registered on the client, and must be a route the SPA serves.
        callbackUrl: 'http://localhost:4000/patreon',
        // Numeric campaign id. Memberships of other campaigns are ignored.
        campaignId: '', // set via PATREON_CAMPAIGN_ID
        // Public campaign page, linked from the profile so a player who is not
        // yet a patron can find it. Blank hides the link.
        campaignUrl: '', // set via PATREON_CAMPAIGN_URL
        requestTimeoutMs: 10000
    },

    // Rating engine (SAS-adjusted Elo). Defaults live in code
    // (server/services/rating/); set values here to override. All of this
    // becomes runtime admin settings once the settings service exists.
    rating: {
        enabled: true,
        ratedTypes: ['casual', 'competitive'], // game types that move ratings
        elo: {
            // See server/services/rating/eloDefaults.js for all knobs:
            // defaultRating, kFactor, provisionalKFactor, provisionalGames,
            // sasWeight, ratingFloor, keyDiffMultipliers, resultTypeMultipliers
        }
    },

    // Decks of KeyForge (decksofkeyforge.com) SAS/AERC integration.
    // Get an API key from your DoK profile page. All values are intended to
    // become runtime admin settings once the settings service exists.
    dok: {
        enabled: true,
        apiUrl: 'https://decksofkeyforge.com/public-api/v3/decks/',
        // Paged listing of one player's own DoK library, used by bulk import.
        // It is the only DoK call sent with the *player's* Api-Key rather than
        // the site's: DoK decides whose collection to return from the key on
        // the request, so there is no way to ask for someone else's.
        myDecksUrl: 'https://decksofkeyforge.com/public-api/v1/my-decks',
        apiKey: '', // set via DOK_API_KEY
        requestTimeoutMs: 10000,
        refreshDays: 30, // SAS scores change between AERC versions; refetch this often
        maxImportDecks: 500, // safety cap on a single bulk import
        // Per-minute cap applied to every DoK key this site sends - the site's
        // own and each player's. 25 is DoK's free tier and is enforced as a
        // CEILING in code: this value can only lower it. Patron tiers allow
        // more, but these windows are per lobby process, so two lobbies each
        // trusting a configured 250 would send 500 - and whether a key really
        // has that tier is DoK's business, not ours. Raising it is a code
        // change (DOK_FREE_TIER_RPM), made by someone who has checked.
        maxRequestsPerMinute: 25,
        // ARCHON: remembered collections. A player may ask us to keep their DoK
        // key (sealed - see server/services/crypto/secretBox.js) and refresh
        // their collection on this cadence. The sweep only LISTS collections
        // and queues jobs; the deck-import worker does the Master Vault work,
        // so raising these lengthens that worker's queue rather than making
        // anything arrive sooner.
        autoSyncEnabled: true,
        autoSyncIntervalHours: 24,
        autoSyncSweepMinutes: 15,
        autoSyncPerRun: 3
    },

    // Master Vault deck catalog: an index of every deck that exists - uuid,
    // name, expansion, houses, no cards - so a player can find their decks by
    // typing a name instead of pasting a Master Vault link. Master Vault has no
    // name lookup of its own, which is why the index has to be built here. SAS
    // is untouched by this: it still comes from DoK.
    //
    // The crawler calls Master Vault from the same address as user-facing deck
    // import, and Master Vault meters the origin rather than the job. So every
    // request the crawl spends is one an importing player may be refused, and
    // the defaults below are deliberately far gentler than Master Vault would
    // tolerate: one page every few seconds, a handful of pages per run, and a
    // circuit breaker that stops asking entirely once errors repeat.
    catalog: {
        // Off until an operator opts in. Indexing the whole of somebody else's
        // API is a decision about their service, not a default to inherit.
        enabled: false,
        // Searching what is already indexed costs Master Vault nothing, so it
        // stays on independently of the crawl - an instance whose crawl has
        // been turned off keeps the catalog it has already built.
        searchEnabled: true,
        mvApiUrl: 'https://www.keyforgegame.com/api/decks/v2',
        pageSize: 25,
        pagesPerRun: 10,
        requestDelayMs: 3000,
        requestTimeoutMs: 15000,
        // Circuit breaker: after this many failures in a row the crawl sleeps,
        // doubling from a minute up to an hour, rather than retrying a page
        // Master Vault has already refused several times.
        maxConsecutiveFailures: 3,
        backoffBaseMs: 60000,
        backoffMaxMs: 3600000,
        maxSearchResults: 50,
        crawlIntervalMinutes: 15
        // Whether name search matches anywhere in the name or only at the
        // start. Unset means "look and see": substring matching needs the
        // pg_trgm index, which the migration creates where the database role
        // is allowed to and skips with a notice where it is not, and running a
        // substring query without it is a sequential scan of the whole catalog
        // on every keystroke. Set true/false only to overrule that detection.
        // substringSearch: true
    },

    // Server-side collection import: the resumable job behind "import my whole
    // Decks of KeyForge collection", and the pace at which the lobby worker is
    // allowed to pull those decks out of Master Vault.
    //
    // Everything here is pacing, and the one thing that matters about it is
    // that the worker is not alone. It leaves from the same address as every
    // user-facing single-deck import, and Master Vault meters the origin rather
    // than the job - so a request this sweep spends is a request some player
    // pasting a deck link is refused. The defaults are therefore deliberately
    // slower than Master Vault would tolerate: nobody sits watching a
    // collection import tick over, and somebody is always watching the single
    // deck they just pasted.
    //
    // Listing the collection is not paced here at all. That happens
    // synchronously against Decks of KeyForge while the job is being created,
    // under the player's own DoK key, and the key is discarded rather than
    // stored - the job holds uuids, and Master Vault has no notion of a DoK key.
    deckImport: {
        // On unless an operator turns it off - the inverse of the catalog
        // crawl's default, because this is the machinery behind a button
        // players already press rather than an outbound job nobody asked for.
        enabled: true,
        decksPerTick: 5,
        requestSpacingMs: 400,
        // Circuit breaker. There is deliberately no failure THRESHOLD here, as
        // the catalog crawl has: a 429 parks the job on the first occurrence,
        // because it is not a symptom to be tolerated a few times, it is the
        // origin telling us to stop. The count only sizes the wait, doubling
        // from a minute up to half an hour - capped lower than the crawl's,
        // because a player is watching this one.
        backoffBaseMs: 60000,
        backoffMaxMs: 1800000,
        // Hard ceiling on a single job's uuid list, well above the
        // dok.maxImportDecks cap a player actually hits.
        maxJobDecks: 1000,
        sweepIntervalSeconds: 10
    },

    gameNode: {
        name: 'test1',
        host: 'localhost',
        socketioPort: 9500

        /*
         * Other game node configurations used, but not specified, include:
         *  - keyPath
         *  - certPath
         *  - maxGames
         */
    }
}
