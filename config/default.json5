{
    env: 'development',

    secret: 'somethingverysecret',
    redisUrl: 'redis://redis/',
    redisKeyPrefix: 'keyteki:dev',
    dbUser: 'keyteki',
    dbHost: 'postgres',
    dbDatabase: 'keyteki',
    dbPassword: 'changemeplease',
    dbPort: 5432,
    minLobbyChatTime: 0, // The time (in seconds) an account has to be registered before it can chat in the lobby
    /*
     * Other global configurations used, but not specified, include:
     *  - sentryDsn (for production only)
     */

    lobby: {
        port: 4000,
        appName: 'Archon Arena',
        emailFromAddress: 'noreply@archonarena.com',
        blockDisposableEmail: false,
        requireActivation: false,
        hmacSecret: 'somethingevenmoresecret',
        lowerDeckThreshold: 1,
        middleDeckThreshold: 2,
        upperDeckThreshold: 3

        /*
         * Other server configurations used, but not specified, include:
         *  - cookieLifetime
         *  - emailKey
         *  - hmacSecret
         *  - captchaKey (hCaptcha secret key)
         *  - awsSesRegion, awsAccessKeyId, awsSecretAccessKey (AWS SES credentials)
         *  - emailFrom, emailReplyTo (email sender addresses)
         */
    },

    // OpenID Connect SSO login. Disabled until a client is registered in the
    // provider realm (Keybringer/Keycloak): the client id/secret and the
    // redirect URI https://<domain>/api/account/oidc/callback must be
    // configured there first.
    auth: {
        oidc: {
            enabled: false,
            providerName: 'keybringer', // stable key used in the identities table
            providerDisplayName: 'Keybringer',
            issuer: 'https://account.keybringer.com/realms/keybringer',
            clientId: '', // set via OIDC_CLIENT_ID
            clientSecret: '', // set via OIDC_CLIENT_SECRET
            redirectUri: 'http://localhost:4000/api/account/oidc/callback',
            scopes: 'openid profile email',
            requestTimeoutMs: 10000
        }
    },

    // Rating engine (SAS-adjusted Elo). Defaults live in code
    // (server/services/rating/); set values here to override. All of this
    // becomes runtime admin settings once the settings service exists.
    rating: {
        enabled: true,
        ratedTypes: ['casual', 'competitive'], // game types that move ratings
        elo: {
            // See server/services/rating/eloDefaults.js for all knobs:
            // defaultRating, kFactor, provisionalKFactor, provisionalGames,
            // sasWeight, ratingFloor, keyDiffMultipliers, resultTypeMultipliers
        }
    },

    // Decks of KeyForge (decksofkeyforge.com) SAS/AERC integration.
    // Get an API key from your DoK profile page. All values are intended to
    // become runtime admin settings once the settings service exists.
    dok: {
        enabled: true,
        apiUrl: 'https://decksofkeyforge.com/public-api/v3/decks/',
        // Collection-filter endpoint used to list a user's whole DoK library
        // for bulk import. Defaults are derived from apiUrl if omitted.
        filterUrl: 'https://decksofkeyforge.com/public-api/v1/decks/filter',
        apiKey: '', // set via DOK_API_KEY
        requestTimeoutMs: 10000,
        refreshDays: 30, // SAS scores change between AERC versions; refetch this often
        maxImportDecks: 500, // safety cap on a single bulk import
        // DoK's per-minute request cap for the site-wide Api-Key. Free tier
        // is 25/min; patron tiers raise it (50 / 100 / 250). Change this to
        // match your DoK subscription (also editable in admin settings).
        maxRequestsPerMinute: 25
    },

    gameNode: {
        name: 'test1',
        host: 'localhost',
        socketioPort: 9500

        /*
         * Other game node configurations used, but not specified, include:
         *  - keyPath
         *  - certPath
         *  - maxGames
         */
    }
}
