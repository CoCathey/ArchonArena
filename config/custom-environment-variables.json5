{
    env: 'NODE_ENV',
    captchaKey: 'CAPTCHA_KEY',
    dbPath: 'DB_PATH',
    dbHost: 'DB_HOST',
    dbPort: 'DB_PORT',
    dbUser: 'DB_USER',
    dbPassword: 'DB_PASSWORD',
    dbDatabase: 'DB_NAME',
    redisUrl: 'REDIS_URL',
    redisKeyPrefix: 'REDIS_KEY_PREFIX',
    gameNodeOrigins: 'GAME_NODE_ORIGINS',
    secret: 'SECRET',
    domain: 'DOMAIN',
    https: 'false',

    lobby: {
        port: 'PORT',
        hmacSecret: 'HMAC_SECRET',
        cspMode: 'CSP_MODE',
        emailKey: 'EMAIL_KEY',
        // Transactional email (activation, password reset) over AWS SES.
        // Without emailFromAddress the site silently cannot send any mail, so a
        // player who forgets their password cannot recover their account.
        emailFromAddress: 'EMAIL_FROM_ADDRESS',
        emailReplyTo: 'EMAIL_REPLY_TO',
        // __format json so REQUIRE_ACTIVATION=false arrives as the boolean
        // false. A bare string mapping would hand the config the string
        // "false", which is truthy, and the override would do the opposite of
        // what whoever set it intended.
        requireActivation: { __name: 'REQUIRE_ACTIVATION', __format: 'json' },
        // Public origin for absolute links in notification email.
        siteUrl: 'SITE_URL',
        awsSesRegion: 'AWS_SES_REGION',
        awsAccessKeyId: 'AWS_ACCESS_KEY_ID',
        awsSecretAccessKey: 'AWS_SECRET_ACCESS_KEY'
    },

    dok: {
        apiKey: 'DOK_API_KEY'
    },

    auth: {
        oidc: {
            enabled: 'OIDC_ENABLED',
            issuer: 'OIDC_ISSUER',
            clientId: 'OIDC_CLIENT_ID',
            clientSecret: 'OIDC_CLIENT_SECRET',
            redirectUri: 'OIDC_REDIRECT_URI'
        }
    },

    gameNode: {
        name: 'SERVER',
        host: 'HOST',
        socketioPort: 'PORT'
    }
}
