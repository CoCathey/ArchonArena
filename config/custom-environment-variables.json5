{
    env: 'NODE_ENV',
    captchaKey: 'CAPTCHA_KEY',
    dbPath: 'DB_PATH',
    dbHost: 'DB_HOST',
    dbPort: 'DB_PORT',
    dbUser: 'DB_USER',
    dbPassword: 'DB_PASSWORD',
    dbDatabase: 'DB_NAME',
    redisUrl: 'REDIS_URL',
    redisKeyPrefix: 'REDIS_KEY_PREFIX',
    gameNodeOrigins: 'GAME_NODE_ORIGINS',
    secret: 'SECRET',
    domain: 'DOMAIN',
    https: 'false',

    lobby: {
        port: 'PORT',
        hmacSecret: 'HMAC_SECRET',
        cspMode: 'CSP_MODE',
        emailKey: 'EMAIL_KEY',
        // Transactional email (activation, password reset) over AWS SES.
        // Without emailFromAddress the site silently cannot send any mail, so a
        // player who forgets their password cannot recover their account.
        emailFromAddress: 'EMAIL_FROM_ADDRESS',
        emailReplyTo: 'EMAIL_REPLY_TO',
        // 'auto' | 'resend' | 'smtp' | 'ses'. Rarely needed - leaving it unset
        // picks Resend when RESEND_API_KEY is set, SMTP when SMTP_HOST is, and
        // SES otherwise.
        emailTransport: 'EMAIL_TRANSPORT',
        // Resend over its HTTP API. One setting and no SMTP at all, which
        // matters because a great many hosts block outbound 587 and 465 and the
        // failure that produces is a connection that hangs rather than an error
        // saying what is wrong.
        resendApiKey: 'RESEND_API_KEY',
        // The provider's plan, as a cap. Resend's free plan is 100 a day and
        // 3,000 a month; past it the provider refuses ALL mail, including the
        // activation link registration depends on. Set these and notification
        // mail yields before that happens. Unset means no cap.
        emailDailyLimit: { __name: 'EMAIL_DAILY_LIMIT', __format: 'json' },
        emailMonthlyLimit: { __name: 'EMAIL_MONTHLY_LIMIT', __format: 'json' },
        emailBulkReserve: { __name: 'EMAIL_BULK_RESERVE', __format: 'json' },
        smtpHost: 'SMTP_HOST',
        // __format json so these arrive as a number and a boolean. A bare string
        // mapping would hand the config "587" and "false", and "false" is truthy.
        smtpPort: { __name: 'SMTP_PORT', __format: 'json' },
        smtpUser: 'SMTP_USER',
        smtpPassword: 'SMTP_PASSWORD',
        smtpSecure: { __name: 'SMTP_SECURE', __format: 'json' },
        // __format json so REQUIRE_ACTIVATION=false arrives as the boolean
        // false. A bare string mapping would hand the config the string
        // "false", which is truthy, and the override would do the opposite of
        // what whoever set it intended.
        requireActivation: { __name: 'REQUIRE_ACTIVATION', __format: 'json' },
        // Public origin for absolute links in notification email.
        siteUrl: 'SITE_URL',
        awsSesRegion: 'AWS_SES_REGION',
        awsAccessKeyId: 'AWS_ACCESS_KEY_ID',
        awsSecretAccessKey: 'AWS_SECRET_ACCESS_KEY'
    },

    dok: {
        apiKey: 'DOK_API_KEY'
    },

    patreon: {
        // __format json so PATREON_ENABLED=false arrives as the boolean false
        // rather than the string "false", which is truthy.
        enabled: { __name: 'PATREON_ENABLED', __format: 'json' },
        clientId: 'PATREON_CLIENT_ID',
        clientSecret: 'PATREON_CLIENT_SECRET',
        callbackUrl: 'PATREON_CALLBACK_URL',
        campaignId: 'PATREON_CAMPAIGN_ID',
        campaignUrl: 'PATREON_CAMPAIGN_URL'
    },

    auth: {
        oidc: {
            enabled: 'OIDC_ENABLED',
            issuer: 'OIDC_ISSUER',
            clientId: 'OIDC_CLIENT_ID',
            clientSecret: 'OIDC_CLIENT_SECRET',
            redirectUri: 'OIDC_REDIRECT_URI'
        }
    },

    gameNode: {
        name: 'SERVER',
        host: 'HOST',
        socketioPort: 'PORT'
    }
}
