{
    env: 'NODE_ENV',
    captchaKey: 'CAPTCHA_KEY',
    dbPath: 'DB_PATH',
    dbHost: 'DB_HOST',
    dbPort: 'DB_PORT',
    dbUser: 'DB_USER',
    dbPassword: 'DB_PASSWORD',
    dbDatabase: 'DB_NAME',
    redisUrl: 'REDIS_URL',
    redisKeyPrefix: 'REDIS_KEY_PREFIX',
    secret: 'SECRET',
    domain: 'DOMAIN',
    https: 'false',

    lobby: {
        port: 'PORT',
        hmacSecret: 'HMAC_SECRET',
        emailKey: 'EMAIL_KEY'
    },

    dok: {
        apiKey: 'DOK_API_KEY'
    },

    auth: {
        oidc: {
            enabled: 'OIDC_ENABLED',
            issuer: 'OIDC_ISSUER',
            clientId: 'OIDC_CLIENT_ID',
            clientSecret: 'OIDC_CLIENT_SECRET',
            redirectUri: 'OIDC_REDIRECT_URI'
        }
    },

    gameNode: {
        name: 'SERVER',
        host: 'HOST',
        socketioPort: 'PORT'
    }
}
